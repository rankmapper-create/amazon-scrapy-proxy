# One proxy per line in this file. Lines beginning with # are ignored.
AMAZON_PROXY_FILE=proxies.txt

# Alternatively, provide comma-separated proxy URLs directly.
# AMAZON_PROXY_URLS=http://user:password@host1:port,http://user:password@host2:port

# Amazon marketplace to scrape. Examples: amazon.in, amazon.com, amazon.co.uk
AMAZON_DOMAIN=amazon.in

# Keep this low. Proxy rotation is not a substitute for polite crawl rates.
AMAZON_DOWNLOAD_DELAY=2.0
AMAZON_CONCURRENT_REQUESTS=2
